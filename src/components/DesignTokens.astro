---
// The colours, gradient, radius and fonts of stratastax-design, from the tokens.json that `npm run sync`
// copied into src/styles/design; each swatch shows its light and dark value and, for a text colour pair,
// the contrast.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

const file = join(process.cwd(), 'src/styles/design/tokens.json');
const tokens = existsSync(file) ? JSON.parse(readFileSync(file, 'utf8')) : null;

const dark = (token) => token.$extensions?.['dev.buijs.stratastax']?.modes?.dark ?? token.$value;
const luminance = (hex) => {
    const channel = (i) => {
        const c = parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255;
        return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
    };
    return 0.2126 * channel(0) + 0.7152 * channel(1) + 0.0722 * channel(2);
};
const contrast = (a, b) => {
    const [la, lb] = [luminance(a), luminance(b)];
    return ((Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05)).toFixed(1);
};

// Every fill with the text colour that goes on it; the rest is shown on its own.
const groups = tokens && [
    { title: 'Brand', names: ['primary', 'secondary', 'secondaryStrong', 'accent', 'highlight', 'focus'] },
    { title: 'Status', names: ['success', 'warning', 'danger'] },
    { title: 'Neutral', names: ['background', 'surface', 'subtle', 'muted', 'border'] },
    { title: 'Subtle fields', names: ['primarySubtle', 'secondarySubtle', 'accentSubtle', 'highlightSubtle', 'warningSubtle', 'dangerSubtle'] },
];
const textOn = (name) => {
    const own = `on${name[0].toUpperCase()}${name.slice(1)}`;
    if (tokens.color[own]) return own;
    if (['muted', 'border', 'focus', 'secondaryStrong'].includes(name)) return null;
    return 'onBackground';
};
const label = (name) => (['muted', 'secondaryStrong'].includes(name) ? 'background' : null);
const swatch = (name, mode) => {
    const pick = (token) => (mode === 'light' ? token.$value : dark(token));
    const fill = pick(tokens.color[name]);
    const fg = textOn(name);
    const onFill = label(name);
    if (onFill) {
        const page = pick(tokens.color[onFill]);
        return { background: page, color: fill, text: 'Aa', value: fill, ratio: contrast(fill, page) };
    }
    if (!fg) return { background: fill, color: fill, text: '', value: fill, ratio: null };
    const text = pick(tokens.color[fg]);
    return { background: fill, color: text, text: 'Aa', value: fill, ratio: contrast(text, fill) };
};
const gradient = tokens?.gradient?.brand;
const css = (stops) => `linear-gradient(${gradient.$extensions['dev.buijs.stratastax'].angle}deg, ${stops.map((s) => s.color).join(', ')})`;
---

{tokens === null ? (
  <p>The tokens were not synchronised into this build; run <code>npm run sync</code>.</p>
) : (
  <div class="not-content design-tokens">
    {groups.map((group) => (
      <section>
        <h3>{group.title}</h3>
        <div class="grid">
          {group.names.map((name) => (
            <figure>
              <div class="swatches">
                {['light', 'dark'].map((mode) => {
                  const s = swatch(name, mode);
                  return (
                    <div class="swatch" style={`background:${s.background};color:${s.color}`} title={`${mode}: ${s.value}`}>
                      <span class="sample">{s.text}</span>
                      <span class="meta">{mode} {s.value}{s.ratio && ` · ${s.ratio}:1`}</span>
                    </div>
                  );
                })}
              </div>
              <figcaption><code>{name}</code></figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}

    <section>
      <h3>Gradient, radius and fonts</h3>
      <div class="grid">
        <figure>
          <div class="swatches">
            <div class="swatch" style={`background:${css(gradient.$value)}`}><span class="meta on-gradient">light</span></div>
            <div class="swatch" style={`background:${css(gradient.$extensions['dev.buijs.stratastax'].modes.dark)}`}><span class="meta on-gradient">dark</span></div>
          </div>
          <figcaption><code>gradient.brand</code></figcaption>
        </figure>
        {['sm', 'md', 'lg'].map((name) => (
          <figure>
            <div class="radius" style={`border-radius:${tokens.radius[name].$value.value}px`}>{tokens.radius[name].$value.value}px</div>
            <figcaption><code>radius.{name}</code></figcaption>
          </figure>
        ))}
      </div>
      <ul class="fonts">
        {Object.entries(tokens.fontFamily).map(([name, font]) => (
          <li style={`font-family:${font.$value.map((f) => `'${f}'`).join(', ')}`}>
            <code>{name}</code> {font.$value[0]}: The quick brown fox records a match
          </li>
        ))}
      </ul>
    </section>
  </div>
)}

<style>
  .design-tokens section + section { margin-top: 2rem; }
  .design-tokens h3 { font-family: var(--stx-font-heading); font-size: 1.1rem; margin-bottom: 0.75rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); }
  figure { margin: 0; }
  figcaption { margin-top: 0.4rem; font-size: 0.85rem; }
  .swatches { display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; border: 1px solid var(--sl-color-hairline); border-radius: var(--stx-radius-lg, 12px); }
  .swatch { display: flex; flex-direction: column; justify-content: space-between; min-height: 5.5rem; padding: 0.5rem; }
  .sample { font-family: var(--stx-font-heading); font-size: 1.4rem; font-weight: 700; }
  .meta { font-size: 0.65rem; line-height: 1.3; }
  .on-gradient { color: #fff; }
  .radius { display: grid; place-items: center; height: 5.5rem; border: 2px solid var(--sl-color-accent); background: var(--sl-color-accent-low); font-size: 0.85rem; }
  .fonts { margin-top: 1.25rem; padding: 0; list-style: none; }
  .fonts li { margin: 0.4rem 0; font-size: 1.05rem; }
</style>
