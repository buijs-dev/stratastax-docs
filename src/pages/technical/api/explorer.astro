---
// Swagger UI for the bundled specs that `npm run sync` copied into public/openapi.
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import 'swagger-ui-dist/swagger-ui.css';
import { colorsOf, ordered } from '../../../data/contracts.mjs';

// The Swagger UI theme of stratastax-design, when `npm run sync` copied it.
import.meta.glob('../../../styles/design/swagger.css', { eager: true });

// Relative to the project root: once bundled, import.meta.url no longer points at this file.
const specIndex = join(process.cwd(), 'public/openapi/index.json');
const specs = ordered(existsSync(specIndex) ? JSON.parse(readFileSync(specIndex, 'utf8')) : []);
const colors = colorsOf(specs);
---

<StarlightPage frontmatter={{ title: 'API explorer', description: 'The Stratastax APIs in Swagger UI.', tableOfContents: false, prev: false, next: false }}>
  {specs.length === 0 ? (
    <p>No specs were synchronised into this build; run <code>npm run sync</code>.</p>
  ) : (
    <>
      <label class="spec-select">
        Spec
        <select id="spec">
          {specs.map((spec) => <option value={`/openapi/${spec.file}`} data-color={colors[spec.name].color}>{spec.title} ({spec.version})</option>)}
        </select>
      </label>
      <div id="swagger-ui" class="not-content"></div>
    </>
  )}
</StarlightPage>

<script>
  import SwaggerUIBundle from 'swagger-ui-dist/swagger-ui-es-bundle.js';

  const select = document.querySelector<HTMLSelectElement>('#spec');

  function show(url: string) {
    // The colour of the contract, as on the home page and in the sidebar.
    const color = select?.selectedOptions[0]?.dataset.color;
    if (color) select?.style.setProperty('--contract', color);
    SwaggerUIBundle({ url, dom_id: '#swagger-ui', deepLinking: true, tryItOutEnabled: false });
  }

  if (select) {
    const requested = new URLSearchParams(location.search).get('spec');
    const option = [...select.options].find((o) => o.value.endsWith(`/${requested}`));
    if (option) select.value = option.value;
    show(select.value);
    select.addEventListener('change', () => {
      const url = new URL(location.href);
      url.searchParams.set('spec', select.value.split('/').pop() ?? '');
      history.replaceState(null, '', url);
      show(select.value);
    });
  }
</script>

<style>
  .spec-select {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-weight: 600;
  }

  .spec-select select {
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-left: 4px solid var(--contract, var(--sl-color-gray-5));
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }

  /* Swagger UI is always light (see swagger.css of stratastax-design): a light panel in both themes. */
  #swagger-ui {
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--stx-radius-lg, 0.75rem);
    background: #fff;
  }

  #swagger-ui :global(.swagger-ui) {
    padding: 0.5rem 1rem;
  }

  /* Phones: the select takes the width, and Swagger UI wraps instead of scrolling the whole page. */
  @media (max-width: 50rem) {
    .spec-select {
      flex-direction: column;
      align-items: stretch;
      gap: 0.35rem;
    }
    .spec-select select {
      width: 100%;
      font-size: 1rem; /* no zoom on focus in iOS */
    }
    #swagger-ui :global(.swagger-ui) {
      padding: 0.25rem 0.5rem;
    }
    #swagger-ui :global(.swagger-ui .wrapper) {
      padding: 0;
    }
    #swagger-ui :global(.swagger-ui .info) {
      margin: 1rem 0;
    }
    #swagger-ui :global(.swagger-ui .opblock .opblock-summary) {
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    #swagger-ui :global(.swagger-ui .opblock .opblock-summary-path),
    #swagger-ui :global(.swagger-ui .opblock .opblock-summary-description) {
      word-break: break-word;
      max-width: 100%;
    }
    #swagger-ui :global(.swagger-ui table),
    #swagger-ui :global(.swagger-ui .model-box),
    #swagger-ui :global(.swagger-ui .highlight-code) {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }
  }
</style>
